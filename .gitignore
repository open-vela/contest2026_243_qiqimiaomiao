# ============================================================
# 参赛仓 .gitignore
# 主要忽略编译产物与本地编辑器配置，避免误提交。
# 注意：logs/ 下最终导出的 AI Coding 日志必须提交，不要忽略！
# ============================================================

# Build artifacts
build/
out/
*.o
*.a
*.elf
*.hex
*.map

# 本地编辑器配置（不提交）
.vscode/

# Claude Code 本地权限配置（含本机路径，不提交）
.claude/settings.local.json

# 工程学习记录（团队内部笔记，暂不提交）
工程学习记录/

# 本地备份与缓存
backup_today/
__pycache__/
